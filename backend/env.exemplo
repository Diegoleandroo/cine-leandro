# Copie este arquivo para .env (na mesma pasta) e preencha. NUNCA suba o .env para o GitHub.

# Django
DJANGO_SECRET_KEY=troque-por-um-texto-longo-e-aleatorio
DJANGO_DEBUG=1
DJANGO_ALLOWED_HOSTS=localhost,127.0.0.1
CORS_ALLOWED_ORIGINS=http://localhost:5173
URL_FRONTEND=http://localhost:5173

# Segurança: pedidos de login/cadastro/recuperação por IP, e quantos proxies há na frente
# do Django (1 = nginx do docker compose; na AWS, CloudFront + load balancer = 2)
LIMITE_ACESSO=20/min
NUM_PROXIES=1

# PostgreSQL (local ou Amazon RDS)
DATABASE_URL=postgres://cinema:cinema@localhost:5432/cinema

# Filmes reais: crie a chave gratuita em https://www.themoviedb.org/settings/api
# e cole o "Token de leitura da API" (começa com eyJ).
TMDB_TOKEN=
# auto = TMDB se houver token, senão catálogo local | local | tmdb
CINEMA_CATALOGO=auto

# E-mail dos avisos: log (mostra no terminal) | ses (Amazon SES)
CINEMA_EMAIL=log
SES_REMETENTE=avisos@seu-dominio.com
AWS_REGION=us-east-1
